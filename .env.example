# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL / SMTP CONFIGURATION: For direct background email dispatching
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# FIREBASE_SERVICE_ACCOUNT: service account JSON (one line) used by the /api routes via firebase-admin.
# Not needed when running against the local emulators.
FIREBASE_SERVICE_ACCOUNT=""

# WEB PUSH / VAPID: For background push notifications to mobile PWA
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:rennaninacio0003@gmail.com"


# BACKGROUND JOBS: Set to "true" for local development so this server does not
# process the shared Firestore email queue. (The hourly Accounts Payable push runs in
# GitHub Actions, see .github/workflows/hourly-payable.yml.)
DISABLE_BACKGROUND_JOBS="false"
