rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions & Helpers

    // A person logged in with their username/password (Firebase Auth email/password account)
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Logged in AND has a profile at users/{uid}. Accounts without a profile get no access.
    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return hasProfile() && role() == 'ADMIN';
    }

    // Mirrors getPermittedStoreIdsForUser in src/lib/firestoreQueryCache.ts
    function canAccessStore(storeId) {
      return hasProfile() && (
        role() == 'ADMIN'
        || (role() == 'MANAGER_BEBELU_MOSSORO' && storeId == '1')
        || (role() == 'MANAGER_BEBELU_RIOMAR_PAPICU' && storeId == '2')
        || (role() == 'MANAGER_VERO_PASTA' && storeId == '3')
        || (!(role() in ['MANAGER_BEBELU_MOSSORO', 'MANAGER_BEBELU_RIOMAR_PAPICU', 'MANAGER_VERO_PASTA'])
            && storeId in ['1', '2', '3'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity-Specific Validation Blueprints (Anti-Update-Gap & Type-Safety)

    function isValidAuditLog(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 128
        && data.userRole is string && data.userRole.size() <= 128
        && data.action is string && data.action.size() <= 128
        && data.description is string && data.description.size() <= 2048
        && data.timestamp is string && data.timestamp.size() <= 128
        && data.userAgent is string && data.userAgent.size() <= 512;
    }

    // Passwords live only in Firebase Auth, never in the profile
    function isValidUser(data) {
      return data.name is string && data.name.size() <= 128
        && data.username is string && data.username.size() <= 128
        && !('password' in data)
        && data.role is string && data.role.size() <= 128
        && (!('biometricEnabled' in data) || data.biometricEnabled is bool);
    }

    function isValidStore(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.brand is string && data.brand.size() <= 128;
    }

    // Collection Security Declarations

    // 1. Audit Logs (Append-Only Global Collection)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidAuditLog(incoming()) && isValidId(logId) && (
        hasProfile()
        // Failed logins are recorded before anyone is authenticated
        || (incoming().action == 'LOGIN_FAILED' && incoming().userId == 'anonymous')
      );
      allow update, delete: if false; // Audit logs are immutable and append-only
    }

    // 2. Users Collection (profiles: name, username, role). Admins manage everyone;
    // people can read their own profile and toggle their own biometric preference.
    match /users/{userId} {
      allow get: if isAdmin() || (hasProfile() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidUser(incoming()) && isValidId(userId);
      allow update: if (isAdmin() && isValidUser(incoming()) && isValidId(userId))
        || (hasProfile() && request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['biometricEnabled', 'updatedAt']));
      allow delete: if isAdmin() && isValidId(userId) && request.auth.uid != userId;
    }

    // 3. Stores Collection (each manager only reaches their own store)
    match /stores/{storeId} {
      allow read: if canAccessStore(storeId);
      allow create, update: if canAccessStore(storeId) && isValidStore(incoming()) && isValidId(storeId);
      allow delete: if isAdmin() && isValidId(storeId);

      // Subcollections of Stores
      match /{collectionId}/{document=**} {
        allow read, write: if canAccessStore(storeId);
      }
    }

    // Backups contain every store and the users list
    match /backups/{backupId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(backupId);

      match /chunks/{chunkId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin() && isValidId(backupId) && isValidId(chunkId);
      }
    }

    // Global notifications for system-wide sync and alerts
    match /global_notifications/{notifId} {
      allow read, write: if hasProfile();
    }

    // FCM tokens and Push subscriptions for background notifications
    match /fcm_tokens/{tokenId} {
      allow read, write: if hasProfile();
    }

    match /push_subscriptions/{subId} {
      allow read, write: if hasProfile();
    }

    // Email dispatch queue for reliable background delivery
    match /email_requests/{reqId} {
      allow read, write: if hasProfile();
    }

    // Test document for SDK initialization checks (runs before login)
    match /test/connection {
      allow read: if true;
    }
  }
}
