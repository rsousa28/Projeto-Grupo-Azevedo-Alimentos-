rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions & Helpers

    // A person logged in with their username/password (Firebase Auth email/password account)
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Logged in AND has a profile at users/{uid}. Accounts without a profile get no access.
    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return hasProfile() && role() == 'ADMIN';
    }

    // Admin e financeiro: veem os números de contas a pagar de todas as lojas
    function isFinance() {
      return hasProfile() && role() in ['ADMIN', 'FINANCIAL'];
    }

    // Mirrors getPermittedStoreIdsForUser in src/lib/firestoreQueryCache.ts
    function canAccessStore(storeId) {
      return hasProfile() && (
        role() == 'ADMIN'
        || (role() == 'MANAGER_BEBELU_MOSSORO' && storeId == '1')
        || (role() == 'MANAGER_BEBELU_RIOMAR_PAPICU' && storeId == '2')
        || (role() == 'MANAGER_VERO_PASTA' && storeId == '3')
        || (!(role() in ['MANAGER_BEBELU_MOSSORO', 'MANAGER_BEBELU_RIOMAR_PAPICU', 'MANAGER_VERO_PASTA'])
            && storeId in ['1', '2', '3'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity-Specific Validation Blueprints (Anti-Update-Gap & Type-Safety)

    function isValidAuditLog(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 128
        && data.userRole is string && data.userRole.size() <= 128
        && data.action is string && data.action.size() <= 128
        && data.description is string && data.description.size() <= 2048
        && data.timestamp is string && data.timestamp.size() <= 128
        && data.userAgent is string && data.userAgent.size() <= 512;
    }

    // Passwords live only in Firebase Auth, never in the profile
    function isValidUser(data) {
      return data.name is string && data.name.size() <= 128
        && data.username is string && data.username.size() <= 128
        && !('password' in data)
        && data.role is string && data.role.size() <= 128
        && (!('biometricEnabled' in data) || data.biometricEnabled is bool);
    }

    function isValidStore(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.brand is string && data.brand.size() <= 128;
    }

    // Collection Security Declarations

    // 1. Audit Logs (Append-Only Global Collection)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidAuditLog(incoming()) && isValidId(logId) && (
        // Each person can only record actions in their own name (admins also record system actions)
        (hasProfile() && (incoming().userId == request.auth.uid || isAdmin()))
        // Failed logins are recorded before anyone is authenticated
        || (incoming().action == 'LOGIN_FAILED' && incoming().userId == 'anonymous' && request.auth == null)
      );
      allow update, delete: if false; // Audit logs are immutable and append-only
    }

    // 2. Users Collection (profiles: name, username, role). Admins manage everyone;
    // people can read their own profile and toggle their own biometric preference.
    match /users/{userId} {
      allow get: if isAdmin() || (hasProfile() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidUser(incoming()) && isValidId(userId);
      allow update: if (isAdmin() && isValidUser(incoming()) && isValidId(userId))
        || (hasProfile() && request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['biometricEnabled', 'updatedAt']));
      allow delete: if isAdmin() && isValidId(userId) && request.auth.uid != userId;
    }

    // 3. Stores Collection (each manager only reaches their own store)
    match /stores/{storeId} {
      allow read: if canAccessStore(storeId);
      allow create, update: if canAccessStore(storeId) && isValidStore(incoming()) && isValidId(storeId);
      allow delete: if isAdmin() && isValidId(storeId);

      // Accounts payable: one document per account, always under the store it belongs to.
      // The legacy single document "all" (and its chunks) is read-only; only the migration marker
      // may be added, so an outdated app can't overwrite the per-account data with an old full list.
      match /accounts_payable/{docId} {
        allow read: if canAccessStore(storeId);
        allow create: if canAccessStore(storeId) && docId != 'all' && isValidId(docId)
          && incoming().storeId == storeId;
        allow update: if canAccessStore(storeId) && (
          (docId != 'all' && incoming().storeId == storeId)
          || (docId == 'all' && incoming().diff(existing()).affectedKeys().hasOnly(['migratedAt', 'migratedBy']))
        );
        allow delete: if canAccessStore(storeId) && docId != 'all';

        match /chunks/{chunkId} {
          allow read: if canAccessStore(storeId);
        }
      }

      // Other subcollections of Stores
      match /{collectionId}/{document=**} {
        allow read, write: if canAccessStore(storeId) && collectionId != 'accounts_payable';
      }
    }

    // Holding (bank loans, liabilities, investments, cash balances): admin and finance only
    match /holding/{docId} {
      allow read, write: if isFinance() && isValidId(docId);
    }

    // Backups contain every store and the users list
    match /backups/{backupId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(backupId);

      match /chunks/{chunkId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin() && isValidId(backupId) && isValidId(chunkId);
      }
    }

    // Notifications shared between devices. Store events (cash closing, checklist) are seen only by
    // whoever can access that store; payable notifications (adminOnly) only by admin and finance.
    match /global_notifications/{notifId} {
      allow read: if isFinance()
        || (hasProfile() && resource.data.adminOnly == false && canAccessStore(resource.data.storeId));
      allow create: if hasProfile() && isValidId(notifId)
        && incoming().createdByUid == request.auth.uid
        && incoming().adminOnly is bool
        && incoming().storeId is string && incoming().storeId.size() <= 32
        && incoming().title is string && incoming().title.size() <= 300
        && incoming().body is string && incoming().body.size() <= 4000
        && (incoming().adminOnly == true || canAccessStore(incoming().storeId));
      allow update, delete: if isAdmin();
    }

    // FCM tokens and Push subscriptions: each person manages only their own devices.
    // The document id ends with the owner's uid, so nobody can overwrite someone else's device.
    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin() || (hasProfile() && resource.data.uid == request.auth.uid);
      allow create, update: if hasProfile() && incoming().uid == request.auth.uid;
      allow delete: if isAdmin() || (hasProfile() && resource.data.uid == request.auth.uid);
    }

    match /push_subscriptions/{subId} {
      allow read: if isAdmin() || (hasProfile() && resource.data.uid == request.auth.uid);
      allow create, update: if hasProfile() && incoming().uid == request.auth.uid
        && subId.matches('.*_' + request.auth.uid + '$');
      allow delete: if isAdmin() || (hasProfile() && resource.data.uid == request.auth.uid);
    }

    // Email queue (local development server only): only finance profiles, only in their own name
    match /email_requests/{reqId} {
      allow read: if isAdmin() || (hasProfile() && resource.data.requestedBy == request.auth.uid);
      allow create: if isFinance() && incoming().requestedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Test document for SDK initialization checks (runs before login)
    match /test/connection {
      allow read: if true;
    }
  }
}
